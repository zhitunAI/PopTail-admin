POP_TAIL_BIND_ADDR=0.0.0.0:8888
POP_TAIL_POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POP_TAIL_DATABASE_URL=postgres://pop_tail:replace-with-a-strong-postgres-password@postgres:5432/pop_tail_auth
POP_TAIL_REDIS_URL=redis://redis:6379/0
POP_TAIL_JWT_SECRET=replace-with-at-least-32-random-characters
POP_TAIL_SERVICE_MODERATION_TOKEN=replace-with-at-least-32-random-characters
POP_TAIL_BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-random-characters
POP_TAIL_DEFAULT_USER_PASSWORD=replace-with-at-least-12-random-characters
POP_TAIL_MULTIPOINT_ENABLED=true
POP_TAIL_COMPATIBILITY_REFRESH_HEADERS=true
RUST_LOG=info
